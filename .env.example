# 작가가 Vercel 화면에서 직접 넣는 값 (여기 실제 값을 쓰지 않는다)
ANTHROPIC_API_KEY=
DATABASE_URL=
ADMIN_KEY=
# 판정기: OpenAI Decisions API로 행동 분류(작가 결정). 없으면 Haiku
OPENAI_API_KEY=
# 선택
JUDGE_SHADOW=haiku   # 기본값. Haiku가 같은 턴을 같이 판정해 일치율 기록, 끄려면 off
JEV_MIN_CONF=0.3 # 이 확신 미만이면 점수 보류
CHAT_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-haiku-5-5
